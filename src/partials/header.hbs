<!-- 顶部导航 -->
<header class="bg-gradient-to-r from-indigo-600 to-blue-500 text-white">
  <div class="container mx-auto px-1 md:px-4 py-2 md:py-3 flex flex-col md:flex-row items-center justify-between">
    <a href="../{{#eq lang 'zh-CN'}}{{else}}{{lang}}/{{/eq}}" class="flex items-center text-white font-bold text-xl space-x-2 hover:text-secondary transition">
      <i class="fa fa-home text-2xl"></i>
      <span>{{nav.home}}</span>
    </a>
    <nav>
      <div class="flex flex-wrap justify-center gap-2 text-sm">
        <a href="../{{url 'download.html'}}" class="flex items-center gap-1 px-2 md:px-3 py-1 md:py-1 rounded hover:bg-white/20 transition">
          <i class="fas fa-download"></i>
          <span class=" md:inline">{{nav.downloads}}</span>
        </a>
        <a href="../{{url 'feedback.html'}}" class="flex items-center gap-1 px-2 md:px-3 py-1 md:py-1 rounded hover:bg-white/20 transition">
          <i class="fas fa-comment"></i>
          <span class=" md:inline">{{nav.feedback}}</span>
        </a>
        <a href="../{{url 'about.html'}}" class="flex items-center gap-1 px-2 md:px-3 py-1 md:py-1 rounded hover:bg-white/20 transition">
          <i class="fas fa-info-circle"></i>
          <span class=" md:inline">{{nav.about}}</span>
        </a>
        <div class="relative inline-block">
          <button id="langBtn" class="flex items-center gap-1 px-2 md:px-3 py-1 md:py-1 rounded hover:bg-white/20 transition">
            <i class="fas fa-globe"></i>
            <span class=" md:inline">{{nav.language}}</span>
          </button>
          <div id="langDropdown" class="absolute right-0 mt-2 w-32 bg-white rounded-lg shadow-lg hidden z-50">
            <a data-lang="zh" href="../" class="block px-4 py-2 text-gray-800 hover:bg-gray-100 transition">
              <span>🇨🇳 {{languages.zh-CN}}</span>
            </a>
            <a data-lang="en" href="../en/" class="block px-4 py-2 text-gray-800 hover:bg-gray-100 transition">
              <span>🇺🇸 {{languages.en}}</span>
            </a>
            <a data-lang="ja-JP" href="../ja-JP/" class="block px-4 py-2 text-gray-800 hover:bg-gray-100 transition">
              <span>🇯🇵 {{languages.ja-JP}}</span>
            </a>
          </div>
        </div>
      </div>
    </nav>
  </div>
</header>
